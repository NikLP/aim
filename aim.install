<?php

/**
 * @file
 * Install hooks for the AIM module.
 */

declare(strict_types=1);

use Drupal\Core\Config\Action\ConfigActionException;

/**
 * Implements hook_install().
 */
function aim_install(bool $is_syncing): void {
  // A config sync, or a recipe (which installs in syncing mode and imports
  // config/install afterwards, then runs aimUseDefaultModels itself), brings
  // its own server config.
  if ($is_syncing) {
    return;
  }

  // The shipped server names no models: take the site's defaults. The action
  // also re-saves the index, which creates the collection table.
  try {
    \Drupal::service('plugin.manager.config_action')
      ->applyAction('aimUseDefaultModels', 'search_api.server.aim_vector', []);
  }
  catch (ConfigActionException $e) {
    \Drupal::logger('aim')->warning('Vector search is not set up: @message Then follow DEVELOPING.md, "Setting up vector search".', ['@message' => $e->getMessage()]);
  }
}

/**
 * Implements hook_uninstall().
 *
 * Config entities that depend on this module are removed by Drupal's own
 * dependency cascade. What it can't see: ai_search's simple config for the
 * index (no uuid) and the vector collection, which lives in the provider's
 * store. This runs before that cascade, so the index and server are still
 * there to name the provider and collection.
 */
function aim_uninstall(): void {
  // Drop the collection so a reinstall starts from an empty one rather than
  // vectors for facts that no longer exist.
  \Drupal::service('aim.vector_store')->dropCollection();

  \Drupal::configFactory()->getEditable('ai_search.index.aim_vector_index')->delete();
}
