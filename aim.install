<?php

/**
 * @file
 * Install hooks for the AIM module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\search_api\IndexInterface;

/**
 * Implements hook_install().
 */
function aim_install(): void {
  // ai_vdb_provider_mariadb only creates/ALTERs the collection table from
  // hook_search_api_index_update(), which does not fire for the insert that
  // config/install triggers. Re-saving forces that update path once the
  // index already exists, so the collection table and its attribute columns
  // actually get created on a fresh install. See CLAUDE.md.
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('aim_vector_index');

  if ($index instanceof IndexInterface) {
    $index->save();
  }
}

/**
 * Implements hook_uninstall().
 *
 * Used to hand-delete every config entity this module ships (ai_guardrail,
 * ai_guardrail_set, aim_scope, search_api_index, search_api_server,
 * taxonomy_vocabulary, view) on the belief that drush pmu's own
 * dependency-based cleanup was unreliable (see CLAUDE.md's "Scope as
 * bundles" gotchas). Re-examined 2026-09-18 (CLAUDE.md's "Code review"
 * deferred-bugs list, item 9): the real cause was that several of those
 * config files shipped with dependencies: {} and no real dependency on
 * `aim` at all, so ConfigManager::uninstall()'s own dependency-graph
 * cleanup had nothing to act on - not that the mechanism itself is
 * unreliable. Every one of those config files now declares (or, for the
 * ones with a genuine functional dependency already, already had) a
 * dependency on `aim`, either real (search_api.index.aim_vector_index,
 * views.view.aim_facts, and every aim_scope entity - a config entity
 * automatically depends on the module providing its own entity type) or
 * `dependencies.enforced.module: [aim]` where no real one exists
 * (ai.ai_guardrail.*, taxonomy.vocabulary.aim_category,
 * search_api.server.aim_vector) - confirmed live via
 * \Drupal::service('config.manager')
 * ->getConfigEntitiesToChangeOnDependencyRemoval('module', ['aim'], FALSE),
 * a read-only simulation of exactly what this hook's caller runs, which
 * now lists every one of those entities (ai_write_guardrails cascades
 * automatically through its own real dependency on the two guardrails, no
 * enforced needed there). `aim.settings` needs no explicit deletion
 * either: ConfigManager::uninstall() unconditionally deletes any simple
 * config whose name is prefixed by the uninstalling module's own name
 * ($name . '.'), and "aim.settings" already matches "aim.".
 *
 * What's left genuinely can't be handled by config dependencies:
 * ai_search.index.aim_vector_index is ai_search's own simple config (not
 * a config entity - no uuid, so it is invisible to the dependency graph
 * entirely, see CLAUDE.md's "Vector search" section), and the
 * aim_fact_vectors collection table is a real database table, not config
 * at all.
 */
function aim_uninstall(): void {
  \Drupal::configFactory()->getEditable('ai_search.index.aim_vector_index')->delete();

  // createCollection() is not idempotent (see CLAUDE.md's "Vector search"
  // gotchas) - drop the collection table outright rather than leaving a
  // stray table for the next install's createCollection() to collide
  // with. Safe if the search_api_index delete (now handled by the config
  // dependency cascade above, not this hook) already dropped it.
  \Drupal::database()->schema()->dropTable('aim_fact_vectors');
}

/**
 * Installs the superseded_by_reason base field on aim_fact.
 */
function aim_update_10004(): void {
  $definition = BaseFieldDefinition::create('string_long')
    ->setName('superseded_by_reason')
    ->setTargetEntityTypeId('aim_fact')
    ->setProvider('aim')
    ->setLabel(t('Retirement reason'))
    ->setDescription(t('JSON provenance for the consolidation decision that retired this fact: decision, auto or model, similarity score, provider and model ID. Never holds fact text.'));
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('superseded_by_reason', 'aim_fact', 'aim', $definition);
}

/**
 * Adds the merged-text verification settings.
 */
function aim_update_10005(): void {
  $path = \Drupal::service('extension.path.resolver')->getPath('module', 'aim') . '/config/install/aim.settings.yml';
  $defaults = Yaml::decode(file_get_contents($path));
  $config = \Drupal::configFactory()->getEditable('aim.settings');
  foreach (['merge_verify', 'merge_max_distance', 'merge_verify_prompt'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, $defaults[$key]);
    }
  }
  // The shipped prompt gained a bias-toward-ADD line; only add it to a
  // prompt that still matches the shipped wording, never overwrite an
  // admin's edits.
  $prompt = (string) $config->get('consolidation_prompt');
  if (!str_contains($prompt, 'choose "ADD"') && str_contains($prompt, 'For any decision other than UPDATE')) {
    $line = "When unsure whether the candidate is a refinement or a distinct fact, choose \"ADD\":\nmerging is where nuance is lost, and keeping both facts is always safe.\n\n";
    $config->set('consolidation_prompt', str_replace('For any decision other than UPDATE', $line . 'For any decision other than UPDATE', $prompt));
  }
  $config->save();
}

/**
 * Moves merge_verifier_model into the per-activity models map.
 */
function aim_update_10006(): void {
  $config = \Drupal::configFactory()->getEditable('aim.settings');
  $empty = ['provider' => '', 'model' => ''];
  $verifier = $empty;
  $old = (string) $config->get('merge_verifier_model');
  if (str_contains($old, '__')) {
    [$verifier['provider'], $verifier['model']] = explode('__', $old, 2);
  }
  $config->set('models', [
    'extraction' => $empty,
    'consolidation' => $empty,
    'verifier' => $verifier,
  ]);
  $config->clear('merge_verifier_model');
  $config->save();
}

/**
 * Implements hook_schema().
 */
function aim_schema(): array {
  return ['aim_activity_metrics' => _aim_activity_metrics_schema()];
}

/**
 * Returns the aim_activity_metrics table definition.
 *
 * One row per tagged provider call, no prompt or fact text (CLAUDE.md's
 * logging rule).
 *
 * @return array
 *   A Schema API table definition.
 */
function _aim_activity_metrics_schema(): array {
  return [
    'description' => 'One row per aim_* provider call: activity, run, provider, model, tokens and time.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'created' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'run_id' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'activity' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE, 'default' => ''],
      'operation_type' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'provider' => ['type' => 'varchar', 'length' => 128, 'not null' => TRUE, 'default' => ''],
      'model' => ['type' => 'varchar', 'length' => 255, 'not null' => TRUE, 'default' => ''],
      'input_tokens' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'output_tokens' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE],
      'duration_ms' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'run_id' => ['run_id'],
      'activity_created' => ['activity', 'created'],
    ],
  ];
}

/**
 * Creates aim_activity_metrics and moves models into activities.
 *
 * Each activity becomes {backend, provider, model}; every existing choice
 * keeps the chat backend.
 */
function aim_update_10007(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('aim_activity_metrics')) {
    $schema->createTable('aim_activity_metrics', _aim_activity_metrics_schema());
  }
  $config = \Drupal::configFactory()->getEditable('aim.settings');
  $activities = [];
  foreach (['extraction', 'consolidation', 'verifier'] as $name) {
    $choice = $config->get('models.' . $name) ?? [];
    $activities[$name] = [
      'backend' => 'chat',
      'provider' => (string) ($choice['provider'] ?? ''),
      'model' => (string) ($choice['model'] ?? ''),
    ];
  }
  $config->set('activities', $activities);
  $config->clear('models');
  $config->save();
}

/**
 * Adds the merge_prompt setting.
 */
function aim_update_10008(): void {
  $defaults = Yaml::decode(file_get_contents(\Drupal::service('extension.list.module')->getPath('aim') . '/config/install/aim.settings.yml'));
  $config = \Drupal::configFactory()->getEditable('aim.settings');
  if ($config->get('merge_prompt') === NULL) {
    $config->set('merge_prompt', $defaults['merge_prompt'])->save();
  }
}
