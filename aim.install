<?php

/**
 * @file
 * Install hooks for the AIM module.
 */

declare(strict_types=1);

use Drupal\search_api\IndexInterface;

/**
 * Implements hook_install().
 */
function aim_install(): void {
  // ai_vdb_provider_mariadb only creates the collection table from
  // hook_search_api_index_update(), which does not fire for the insert that
  // config/install triggers. Re-save the index once to force that path.
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('aim_vector_index');

  if ($index instanceof IndexInterface) {
    $index->save();
  }
}

/**
 * Implements hook_uninstall().
 *
 * Config entities that depend on this module are removed by Drupal's own
 * dependency cascade. What it can't see: ai_search's simple config for the
 * index (no uuid) and the collection table, which is a real database table.
 */
function aim_uninstall(): void {
  \Drupal::configFactory()->getEditable('ai_search.index.aim_vector_index')->delete();

  // createCollection() is not idempotent, so don't leave a stray table behind.
  \Drupal::database()->schema()->dropTable('aim_fact_vectors');
}

/**
 * Removes the trust policy settings and renames the grounded check's modes.
 *
 * ADR-0065: starting trust is the writer's permission, so trust_policy and
 * default_trusted go; merge_max_distance goes with the distance check;
 * grounding_mode shadow and enforce become record and demote.
 */
function aim_update_10014(): void {
  $config = \Drupal::configFactory()->getEditable('aim.settings');
  $mode = $config->get('grounding_mode');
  $config->set('grounding_mode', match ($mode) {
    'shadow' => 'record',
    'enforce' => 'demote',
    'record', 'demote' => $mode,
    default => 'off',
  });
  foreach (['trust_policy', 'default_trusted', 'merge_max_distance'] as $key) {
    $config->clear($key);
  }

  // The RETIRE option goes from the classifier; its paragraph is removed
  // from the prompt, as shipped or as saved by the settings form (CRLF).
  $prompt = (string) $config->get('consolidation_prompt');
  $config->set('consolidation_prompt', preg_replace('/^[ \t]*- "RETIRE":.*\R.*Use sparingly\.\R/m', '', $prompt));
  $config->save();
}

/**
 * Makes aim_fact revisionable (ADR-0064).
 *
 * Each existing fact gets one revision, by its writer at its creation time:
 * edits made before this update left no trail.
 */
function aim_update_10015(array &$sandbox): void {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  if ($update_manager->getEntityType('aim_fact')->isRevisionable()) {
    return;
  }
  $entity_type = \Drupal::entityTypeManager()->getDefinition('aim_fact');
  $field_storage_definitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('aim_fact');
  $update_manager->updateFieldableEntityType($entity_type, $field_storage_definitions, $sandbox);
  if (($sandbox['#finished'] ?? 1) < 1) {
    return;
  }

  $database = \Drupal::database();
  $query = $database->select('aim_fact', 'f')->fields('f', ['id', 'uid', 'created']);
  foreach ($query->execute() as $fact) {
    $database->update('aim_fact_revision')
      ->fields([
        'revision_user' => $fact->uid,
        'revision_created' => $fact->created,
        'revision_log_message' => 'Revision history starts here: earlier edits were not recorded.',
      ])
      ->condition('id', $fact->id)
      ->execute();
  }
}
