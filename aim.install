<?php

/**
 * @file
 * Install hooks for the AIM module.
 */

declare(strict_types=1);

use Drupal\search_api\IndexInterface;

/**
 * Implements hook_install().
 */
function aim_install(): void {
  // ai_vdb_provider_mariadb only creates the collection table from
  // hook_search_api_index_update(), which does not fire for the insert that
  // config/install triggers. Re-save the index once to force that path.
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('aim_vector_index');

  if ($index instanceof IndexInterface) {
    $index->save();
  }
}

/**
 * Implements hook_uninstall().
 *
 * Config entities that depend on this module are removed by Drupal's own
 * dependency cascade. What it can't see: ai_search's simple config for the
 * index (no uuid) and the collection table, which is a real database table.
 */
function aim_uninstall(): void {
  \Drupal::configFactory()->getEditable('ai_search.index.aim_vector_index')->delete();

  // createCollection() is not idempotent, so don't leave a stray table behind.
  \Drupal::database()->schema()->dropTable('aim_fact_vectors');
}
