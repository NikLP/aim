<?php

/**
 * @file
 * Install hooks for the AIM Tool module.
 */

declare(strict_types=1);

/**
 * Implements hook_uninstall().
 *
 * Drush pmu does not reliably remove every config/install entity on its
 * own (reproduced twice against aim's/aim_chatbot's own config - see
 * CLAUDE.md's "Scope as bundles" gotchas), leaving orphans that throw
 * PreExistingConfigException on the next install. Delete everything this
 * module ships explicitly instead of relying on dependency-based cleanup.
 *
 * The mcp_tool_config entities live in config/optional and only exist when
 * mcp_server_tool_bridge is enabled, which is no longer a hard dependency
 * of this module - so the entity type may not be defined at all here.
 */
function aim_tool_uninstall(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->hasDefinition('mcp_tool_config')) {
    return;
  }
  
  $storage = $entity_type_manager->getStorage('mcp_tool_config');
  foreach ($storage->loadMultiple(['aim_remember', 'aim_recall']) as $entity) {
    $entity->delete();
  }
}
